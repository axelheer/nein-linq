<Project>

  <Import Project="..\build.props" />

  <PropertyGroup>
    <DefaultNamespace>NeinLinq.Tests</DefaultNamespace>
    <TargetFrameworks>net11.0;net10.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>exe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
